--- !tapi-tbd
# SPDX-License-Identifier: AGPL-3.0-or-later
# Self-authored sample-local extension of app-probe/stubs/UIKit.tbd.
# Only UIScrollView is added for the owned subclass superclass reference.
# No implementation or Apple SDK content.
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/System/Library/Frameworks/UIKit.framework/UIKit'
exports:
  - targets: [ arm64-ios ]
    symbols: [ _UIApplicationMain ]
    objc-classes: [ UIScrollView, UIViewController, UIWindow, UIScreen, UILabel, UIButton, UIFont, UIColor ]
...
