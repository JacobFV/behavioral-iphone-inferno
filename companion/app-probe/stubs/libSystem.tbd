--- !tapi-tbd
# SPDX-License-Identifier: AGPL-3.0-or-later
# Self-authored symbol declarations; no implementation or Apple SDK content.
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-ios ]
    symbols: [ dyld_stub_binder, _setgroups, _setgid, _setuid, _getuid, _getgid, _lstat, _bzero, _printf, _fflush, _strcmp, _fork, _execve, _waitpid, __exit, _sync, _access, _mkdir, _unmount, _chmod, _chown, ___error, _copyfile, _open, _close, _read, _getattrlist, _statfs, _sleep, _alarm, _snprintf, _write ]
...
