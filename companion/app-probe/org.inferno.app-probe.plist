<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.inferno.app-probe</string>
<key>ProgramArguments</key><array>
<string>/private/var/inferno/inferno-launcher</string>
<string>/private/var/inferno/InfernoProbe.app</string>
<string>org.inferno.companion.probe</string>
</array>
<key>UserName</key><string>mobile</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><false/>
<key>StandardOutPath</key><string>/dev/console</string>
<key>StandardErrorPath</key><string>/dev/console</string>
<key>EnvironmentVariables</key><dict>
<key>HOME</key><string>/var/mobile</string>
<key>CFFIXED_USER_HOME</key><string>/var/mobile</string>
<key>TMPDIR</key><string>/var/tmp</string>
</dict>
</dict></plist>
