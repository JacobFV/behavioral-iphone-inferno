<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CFFIXED_USER_HOME</key>
		<string>/var/mobile</string>
		<key>HOME</key>
		<string>/var/mobile</string>
		<key>TMPDIR</key>
		<string>/var/tmp</string>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>org.inferno.app-probe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/inferno-launcher</string>
		<string>/private/var/inferno/InfernoProbe.app</string>
		<string>org.inferno.companion.probe</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>UserName</key>
	<string>mobile</string>
</dict>
</plist>
