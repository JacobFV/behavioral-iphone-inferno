--- !tapi-tbd
# SPDX-License-Identifier: AGPL-3.0-or-later
# Self-authored symbol declarations; no implementation or Apple SDK content.
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
exports:
  - targets: [ arm64-ios ]
    symbols: [ _mach_absolute_time, _mach_timebase_info, __dispatch_main_q, _dispatch_async_f, _dispatch_after_f, _dispatch_time, _socket, _connect, _bind, _listen, _accept, _fcntl, _poll, _setsockopt, _getsockopt, _send, _recv, _fchmod, _ftruncate, _sysctlbyname, _fstat, _getuid, _getpid, _open, _close, ___error, dyld_stub_binder, __NSConcreteGlobalBlock, _kill, _setgroups, _setgid, _setuid, _getuid, _getgid, _lstat, _bzero, _printf, _fflush, _strcmp, _fork, _execve, _waitpid, __exit, _sync, _access, _mkdir, _unmount, _chmod, _chown, ___error, _copyfile, _open, _close, _read, _getattrlist, _statfs, _sleep, _alarm, _snprintf, _write, _dlopen, _dlsym, _getifaddrs, _freeifaddrs, _inet_ntop ]
...
