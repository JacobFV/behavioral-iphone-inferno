--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1.0
compatibility-version: 1.0
exports:
  - targets: [ arm64-ios ]
    symbols: [ dyld_stub_binder, _bzero, _printf, _snprintf, _fflush, _strcmp, _access, _fork, _execve, _waitpid, _mkdir, _unmount, ___error, __exit, _sync, _sleep, _copyfile, _getattrlist ]
...
