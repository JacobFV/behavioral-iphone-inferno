--- !tapi-tbd
tbd-version: 4
targets: [ arm64-ios ]
install-name: '/usr/lib/libSystem.B.dylib'
current-version: 1.0
compatibility-version: 1.0
exports:
  - targets: [ arm64-ios ]
    symbols: [ _sysctlbyname, _fstat, _mach_task_self_, _signal, _usleep, _mach_absolute_time, _mach_timebase_info, _setuid, _setgid, _setgroups, _write, _dlopen, _dlsym, _dlerror, _lstat, _readlink, _statfs, _opendir, _readdir, _closedir, _open, _read, _lseek, _close, dyld_stub_binder, _bzero, _printf, _snprintf, _fflush, _strcmp, _access, _fork, _execve, _waitpid, _mkdir, _unmount, ___error, __exit, _sync, _sleep, _alarm, _kill, _copyfile, _getattrlist ]
...
