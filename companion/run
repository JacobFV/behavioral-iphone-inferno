#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command=${1:-help}
if (($#)); then shift; fi
case "$command" in
    app-import) exec python3 "$root/companion/app-import.py" "$@" ;;
    build-import-launcher) exec python3 "$root/companion/app-probe/build-import-launcher.py" "$@" ;;
    stage-import) exec python3 "$root/companion/stage-import.py" "$@" ;;
    prepare-import) exec python3 "$root/companion/prepare-import.py" "$@" ;;
    verify-import-stage) exec python3 "$root/companion/verify-import-stage.py" "$@" ;;
    status) exec python3 "$root/companion/status.py" "$@" ;;
    check) exec python3 "$root/companion/smoke.py" --binary "$root/.local-build/build/qemu-system-aarch64" "$@" ;;
    prepare) exec python3 "$root/companion/prepare-profile.py" "$@" ;;
    boot) exec python3 "$root/companion/boot.py" "$@" ;;
    control) exec python3 "$root/companion/qmp_control.py" "$@" ;;
    owned-control) exec python3 "$root/companion/owned-control.py" "$@" ;;
    display-trace-checkpoint) exec python3 "$root/companion/display-trace-checkpoint.py" "$@" ;;
    observe) exec python3 "$root/companion/vnc-control.py" "$@" ;;
    launch-timing|warm-timing|process-launch-timing)
        exec python3 "$root/companion/$command.py" "$@" ;;
    resources) exec python3 "$root/companion/measure-process.py" "$@" ;;
    density) exec python3 "$root/companion/measure-density.py" "$@" ;;
    preserve-stopped) exec python3 "$root/companion/preserve-stopped.py" "$@" ;;
    sample-result) exec python3 "$root/companion/sample-result.py" "$@" ;;
    verify-journey) exec python3 "$root/companion/verify-journey.py" "$@" ;;
    build) exec "$root/companion/build-linux.sh" --build-root "$root/.local-build" --jobs 8 "$@" ;;
    version) exec "$root/.local-build/build/qemu-system-aarch64" --version "$@" ;;
    help|-h|--help)
        printf '%s\n' 'Usage: companion/run COMMAND [arguments]; COMMAND --help for options' \
          '  app-import  validate and unpack an unencrypted developer IPA outside Git' \
          '  build-import-launcher  build owned helpers bound to an imported app' \
          '  stage-import  run and verify one prepared IPA recovery stage' \
          '  prepare-import  prepare an external pinned IPA recovery session without booting' \
          '  verify-import-stage  check raw recovery content or stopped-stage eligibility' \
          '  status   inspect the durable build and saved execution evidence' \
          '  check    run a fresh headless, firmware-free QMP check' \
          '  prepare  prepare a pinned recovery input profile outside Git' \
          '  boot     bounded headless recovery or installed-iOS attempt' \
          '  control  explicit action/status through the runner mailbox' \
          '  owned-control  record one explicit owned HID gesture or app OPEN' \
          '  display-trace-checkpoint  record a read-only trace log boundary' \
          '  observe  headless private VNC captures or explicit Home button' \
          '  launch-timing|warm-timing|process-launch-timing  derive guest clocks' \
          '  resources  measure one live emulator process' \
          '  density  measure exactly two live sibling emulator processes' \
          '  preserve-stopped  verify normal shutdown and retain seven-disk hashes' \
          '  sample-result  reconstruct one named original-tool sample without input' \
          '  verify-journey  corroborate a stopped strict journey from raw records' \
          '  build    rebuild the current committed fork; optional --jobs 1..8' \
          '  version  print the actual executable version' ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; exit 2 ;;
esac
